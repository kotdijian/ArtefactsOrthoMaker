+            )
+            self.pottery_cylinder_d_spin.setValue(
+                self.pottery_cylinder_d_spin.value() * ratio
+            )
+            for row in range(self.pottery_fan_table.rowCount()):
+                for col in (0, 1):
+                    item = self.pottery_fan_table.item(row, col)
+                    if item is not None:
