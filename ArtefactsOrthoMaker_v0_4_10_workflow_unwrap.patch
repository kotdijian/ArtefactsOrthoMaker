+            hard = (
+                m["canvas_w_px"] > MAX_PNG_DIMENSION_PX
+                or m["canvas_h_px"] > MAX_PNG_DIMENSION_PX
+                or m["pixels"] > MAX_PNG_PIXELS
+            )
+            estimated = m["pixels"] * max(float(bpp), 0.01)
+            return (not hard and estimated <= byte_limit), m
